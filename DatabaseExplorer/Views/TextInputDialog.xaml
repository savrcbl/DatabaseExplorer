<Window x:Class="DatabaseExplorer.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />

            <TextBox x:Name="InputTextBox"
                     Margin="0,0,0,16"
                     KeyDown="InputTextBox_KeyDown" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="88" Margin="0,0,8,0"
                        IsCancel="True" Click="CancelButton_Click" />
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButtonStyle}" Width="88"
                        IsDefault="True" Click="OkButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
