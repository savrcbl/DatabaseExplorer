<Application x:Class="DatabaseExplorer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DatabaseExplorer.Helpers.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme colors: index 0 is swapped at runtime by ThemeService between
                     Colors.Light.xaml and Colors.Dark.xaml. Loaded light by default so
                     design-time preview and the first frame both render sensibly. -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters are registered here (rather than per-window) so they're also
                 available to reusable controls such as Controls/BusyOverlay.xaml. -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
