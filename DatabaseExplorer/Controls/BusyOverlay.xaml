<UserControl x:Class="DatabaseExplorer.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False"
             IsHitTestVisible="False">
    <Border Background="{DynamicResource OverlayBrush}"
            CornerRadius="{StaticResource PanelCornerRadius}"
            Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
            <ProgressBar IsIndeterminate="True" Width="160" Height="3" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Message, ElementName=Root}"
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
